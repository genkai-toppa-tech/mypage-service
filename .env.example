# このファイルをコピーして .env.local を作成してください。
# 値は Supabase ダッシュボードの Project Settings → API から取得できます。

# Supabase プロジェクトのURL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# publishable キー（sb_publishable_ で始まる）。ブラウザに露出する前提のキーで、RLS で保護される。
# レガシーの anon キー（JWT形式）も当面は動作するが、2026年末に廃止予定のため使わない。
# secret キー（sb_secret_）はここにも Vercel にも設定しないこと（RLS を素通りするため）。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# マイグレーション適用（pnpm drizzle-kit migrate）でのみ使う接続文字列。
# Supabase ダッシュボードの Connect → ORMs から取得する。アプリ実行時には不要。
DATABASE_URL=

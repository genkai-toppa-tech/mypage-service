# このファイルをコピーして .env.local を作成してください。
# 値は Supabase ダッシュボードの Project Settings → API から取得できます。

# Supabase プロジェクトのURL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon / public キー。ブラウザに露出する前提のキーで、RLS で保護される。
# service_role キーはここにも Vercel にも設定しないこと（RLS を素通りするため）。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# マイグレーション適用（pnpm drizzle-kit migrate）でのみ使う接続文字列。
# Supabase ダッシュボードの Connect → ORMs から取得する。アプリ実行時には不要。
DATABASE_URL=
